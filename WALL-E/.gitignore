# Python bytecode from running the brain code locally
__pycache__/
*.pyc

# Virtual environment for the brain
.venv/

# Downloaded speech models (hundreds of MB to GB). Keep the README.
models/*
!models/README.md
brain/models/**
!brain/models/**/
!brain/models/**/README.md
!brain/models/**/README.html
!brain/models/**/.gitattributes
# Whisper for the Mac GPU: its README comes with the download.
brain/models/whisper-en-mlx/
brain/models/whisper-turbo-mlx/
# Hebrew models (ivrit.ai Whisper, Kokoro Hebrew, Phonikud): downloads.
brain/models/he/
hebrew_try.wav
hebrew_talk.wav
brain/hebrew_try.wav
brain/hebrew_talk.wav
brain/english_talk.wav

# WALL-E's songs: yours, not the repo's. Keep the README.
brain/music/*
!brain/music/README.md
!brain/music/README.html
# Spotify login token and your song list: private.
brain/spotify/
# Shahar's face features and hashed secret word (owner.py): private.
brain/owner/
# People WALL-E remembers (face features, photo, notes), with their yes: never in git.
brain/persons/
brain/personality_history/
brain/personalities/*/*/history/
# Transcripts of the videos a personality was made from: not ours to publish.
brain/personalities/*/*/source/

# OpenSCAD exports. The PNG renders ARE committed; meshes are not.
*.stl
*.dxf
*.csg

# macOS folder junk
.DS_Store

# scratch renders: the guide embeds them, so they are never committed
build/
